/* Solo despliegue de PRUEBAS. Propiedades requeridas: SPREADSHEET_ID y ADMIN_EMAIL.
   Ejecutar como propietario; acceso Solo yo. No publicar ni abrir a cualquiera. */
const HEADERS=['ID_CURSO','ID_SESION','CATEGORIA','CURSO','FECHA','HORA_INICIO','HORA_FIN','LUGAR','CONVOCADOS','ACTIVO','CREADO_EN','ACTUALIZADO_EN','VERSION'];
function authorized_(){const expected=PropertiesService.getScriptProperties().getProperty('ADMIN_EMAIL');const actual=Session.getActiveUser().getEmail();if(!expected||!actual||actual.toLowerCase()!==expected.toLowerCase())throw new Error('Acceso no autorizado. Abre la aplicación con tu cuenta administradora.');}
function sheet_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('Falta configurar la hoja de pruebas.');const s=SpreadsheetApp.openById(id).getSheetByName('SESIONES');if(!s)throw new Error('No existe la pestaña SESIONES.');const h=s.getRange(1,1,1,HEADERS.length).getValues()[0];if(JSON.stringify(h)!==JSON.stringify(HEADERS))throw new Error('Las columnas no coinciden. No se ha escrito nada.');return s;}
function read_(s){if(s.getLastRow()<2)return [];return s.getRange(2,1,s.getLastRow()-1,HEADERS.length).getDisplayValues().filter(r=>r[1]).map(r=>Object.fromEntries(HEADERS.map((h,i)=>[h,h==='ACTIVO'?r[i]==='TRUE':h==='VERSION'?Number(r[i]):r[i]])));}
function doGet(e){authorized_();const view=e&&e.parameter&&e.parameter.view==='tv'?'Tv':'Admin';return HtmlService.createHtmlOutputFromFile(view).setTitle('Cursos | PRUEBAS');}
function listSessions(){authorized_();return read_(sheet_());}
function dateValid_(v){if(!/^\d{4}-\d{2}-\d{2}$/.test(v||''))return false;const d=new Date(v+'T12:00:00Z');return !isNaN(d)&&d.toISOString().slice(0,10)===v;}
function validate_(r){for(const k of ['ID_CURSO','ID_SESION','CATEGORIA','CURSO','LUGAR','CONVOCADOS'])if(typeof r[k]!=='string'||!r[k].trim()||r[k].length>10000)throw new Error(k+': contenido no válido');if(!dateValid_(r.FECHA))throw new Error('Fecha no válida');for(const k of ['HORA_INICIO','HORA_FIN'])if(!/^([01]\d|2[0-3]):[0-5]\d$/.test(r[k]||''))throw new Error('Horario no válido');if(r.HORA_FIN<=r.HORA_INICIO)throw new Error('La hora final debe ser posterior');if(typeof r.ACTIVO!=='boolean')throw new Error('ACTIVO no válido');}
function rawCell_(v){if(typeof v==='string'&&/^\s*[=+@-]/.test(v))return "'"+v;return v;}
function write_(s,rows){const values=[HEADERS,...rows.map(r=>HEADERS.map(h=>rawCell_(r[h]??'')))];const previous=Math.max(s.getLastRow(),1);const needed=Math.max(previous,values.length);while(values.length<needed)values.push(HEADERS.map(()=>''));s.getRange(1,1,values.length,HEADERS.length).setNumberFormat('@').setValues(values);SpreadsheetApp.flush();}
function saveSessions(sessions,deletedIds,versions){authorized_();if(!Array.isArray(sessions)||!sessions.length||sessions.length>50||!Array.isArray(deletedIds)||deletedIds.length>50)throw new Error('Solicitud no válida');sessions.forEach(validate_);const ids=sessions.map(r=>r.ID_SESION);if(new Set(ids).size!==ids.length)throw new Error('Sesiones duplicadas');const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=sheet_();const old=read_(s);const changed=new Set(ids.concat(deletedIds));for(const r of old)if(changed.has(r.ID_SESION)&&Number(versions[r.ID_SESION])!==r.VERSION)throw new Error('La convocatoria cambió. Recarga antes de guardar.');const now=new Date().toISOString();const next=old.filter(r=>!changed.has(r.ID_SESION));for(const r of sessions){const prev=old.find(x=>x.ID_SESION===r.ID_SESION);next.push({...r,CREADO_EN:prev?prev.CREADO_EN:now,ACTUALIZADO_EN:now,VERSION:prev?prev.VERSION+1:1});}write_(s,next);return read_(s);}finally{lock.releaseLock();}}
function deleteSession(id,version){authorized_();const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=sheet_();const rows=read_(s);const r=rows.find(x=>x.ID_SESION===id);if(!r||r.VERSION!==Number(version))throw new Error('La convocatoria cambió. Recarga antes de eliminar.');write_(s,rows.filter(x=>x.ID_SESION!==id));return read_(s);}finally{lock.releaseLock();}}

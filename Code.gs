/* Backend de PRUEBAS. Solo la hoja nueva. Sin claves ni ID de hoja en el código.
Propiedades: SPREADSHEET_ID, ADMIN_EMAIL. FRONTEND_BASE_URL opcional cuando se active Pages.
Acceso del despliegue de pruebas: ejecutar como propietario, Cualquiera.
La página setup exige la identidad Google del propietario. Las APIs exigen llave. */
const HEADERS=['ID_CURSO','ID_SESION','CATEGORIA','CURSO','FECHA','HORA_INICIO','HORA_FIN','LUGAR','CONVOCADOS','ACTIVO','CREADO_EN','ACTUALIZADO_EN','VERSION','TIPO_CONVOCATORIA'];
function authorized_(){const expected=PropertiesService.getScriptProperties().getProperty('ADMIN_EMAIL');const actual=Session.getActiveUser().getEmail();if(!expected||!actual||actual.toLowerCase()!==expected.toLowerCase())throw new Error('Acceso no autorizado. Abre la aplicación con tu cuenta administradora.');}
function sheet_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('Falta configurar la hoja de pruebas.');const s=SpreadsheetApp.openById(id).getSheetByName('SESIONES');if(!s)throw new Error('No existe la pestaña SESIONES.');const h=s.getRange(1,1,1,HEADERS.length).getValues()[0];if(JSON.stringify(h)!==JSON.stringify(HEADERS)&&!(JSON.stringify(h.slice(0,-1))===JSON.stringify(HEADERS.slice(0,-1))&&!h[h.length-1]))throw new Error('Las columnas no coinciden. No se ha escrito nada.');return s;}
function read_(s){if(s.getLastRow()<2)return [];return s.getRange(2,1,s.getLastRow()-1,HEADERS.length).getDisplayValues().filter(r=>r[1]).map(r=>Object.fromEntries(HEADERS.map((h,i)=>[h,h==='TIPO_CONVOCATORIA'?(r[i]||'SESIONES'):h==='ACTIVO'?String(r[i]).toUpperCase()==='TRUE':h==='VERSION'?Number(r[i]):r[i]])));}
function dateValid_(v){if(!/^\d{4}-\d{2}-\d{2}$/.test(v||''))return false;const d=new Date(v+'T12:00:00Z');return !isNaN(d)&&d.toISOString().slice(0,10)===v;}
function validate_(r){if(r.TIPO_CONVOCATORIA&&!['SESIONES','ALTERNATIVAS'].includes(r.TIPO_CONVOCATORIA))throw new Error('Tipo de convocatoria no válido');for(const k of ['ID_CURSO','ID_SESION','CATEGORIA','CURSO','LUGAR','CONVOCADOS'])if(typeof r[k]!=='string'||!r[k].trim()||r[k].length>10000)throw new Error(k+': contenido no válido');if(!dateValid_(r.FECHA))throw new Error('Fecha no válida');for(const k of ['HORA_INICIO','HORA_FIN'])if(!/^([01]\d|2[0-3]):[0-5]\d$/.test(r[k]||''))throw new Error('Horario no válido');if(r.HORA_FIN<=r.HORA_INICIO)throw new Error('La hora final debe ser posterior');if(typeof r.ACTIVO!=='boolean')throw new Error('ACTIVO no válido');}
function rawCell_(v){if(typeof v==='string'&&/^\s*[=+@-]/.test(v))return "'"+v;return v;}
function write_(s,rows){const values=[HEADERS,...rows.map(r=>HEADERS.map(h=>rawCell_(h==='TIPO_CONVOCATORIA'?(r[h]||'SESIONES'):(r[h]??''))))];const previous=Math.max(s.getLastRow(),1);const needed=Math.max(previous,values.length);while(values.length<needed)values.push(HEADERS.map(()=>''));s.getRange(1,1,values.length,HEADERS.length).setNumberFormat('@').setValues(values);SpreadsheetApp.flush();}
function saveSessions_(sessions,deletedIds,versions){if(!Array.isArray(sessions)||!sessions.length||sessions.length>50||!Array.isArray(deletedIds)||deletedIds.length>50)throw new Error('Solicitud no válida');sessions.forEach(validate_);const ids=sessions.map(r=>r.ID_SESION);if(new Set(ids).size!==ids.length)throw new Error('Sesiones duplicadas');const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=sheet_();const old=read_(s);const changed=new Set(ids.concat(deletedIds));for(const r of old)if(changed.has(r.ID_SESION)&&Number(versions[r.ID_SESION])!==r.VERSION)throw new Error('La convocatoria cambió. Recarga antes de guardar.');const now=new Date().toISOString();const next=old.filter(r=>!changed.has(r.ID_SESION));for(const r of sessions){const prev=old.find(x=>x.ID_SESION===r.ID_SESION);next.push({...r,TIPO_CONVOCATORIA:r.TIPO_CONVOCATORIA||(prev&&prev.TIPO_CONVOCATORIA)||'SESIONES',CREADO_EN:prev?prev.CREADO_EN:now,ACTUALIZADO_EN:now,VERSION:prev?prev.VERSION+1:1});}for(const course of new Set(next.map(r=>r.ID_CURSO))){const siblings=next.filter(r=>r.ID_CURSO===course);if(new Set(siblings.map(r=>r.TIPO_CONVOCATORIA||'SESIONES')).size>1)throw new Error('El tipo debe ser el mismo para todo el curso');if(siblings[0].TIPO_CONVOCATORIA==='ALTERNATIVAS'&&new Set(siblings.map(r=>r.CONVOCADOS.trim())).size>1)throw new Error('Los horarios a elegir deben compartir el mismo grupo');}write_(s,next);return read_(s);}finally{lock.releaseLock();}}
function deleteSession_(id,version){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=sheet_();const rows=read_(s);const r=rows.find(x=>x.ID_SESION===id);if(!r||r.VERSION!==Number(version))throw new Error('La convocatoria cambió. Recarga antes de eliminar.');write_(s,rows.filter(x=>x.ID_SESION!==id));return read_(s);}finally{lock.releaseLock();}}

function digest_(value){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value,Utilities.Charset.UTF_8).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
function constantEqual_(a,b){if(typeof a!=='string'||typeof b!=='string'||a.length!==b.length)return false;let diff=0;for(let i=0;i<a.length;i++)diff|=a.charCodeAt(i)^b.charCodeAt(i);return diff===0;}
function permission_(key){if(typeof key!=='string'||!/^[a-f0-9]{64}$/.test(key))throw new Error('Enlace no válido o revocado.');const hash=digest_(key),p=PropertiesService.getScriptProperties();if(constantEqual_(hash,p.getProperty('TEST_ADMIN_KEY_HASH')))return 'admin';if(constantEqual_(hash,p.getProperty('TEST_TV_KEY_HASH')))return 'tv';throw new Error('Enlace no válido o revocado.');}
function limited_(role){const cache=CacheService.getScriptCache(),slot=Math.floor(Date.now()/60000),id='rate:'+role+':'+slot;const n=Number(cache.get(id)||0);if(n>=90)throw new Error('Demasiadas solicitudes. Espera un minuto.');cache.put(id,String(n+1),65);}
function api(request){try{if(!request||typeof request!=='object')throw new Error('Solicitud no válida.');const role=permission_(request.key);limited_(role);const op=request.op;if(!['list','save','remove'].includes(op))throw new Error('Operación no válida.');if(role!=='admin'&&op!=='list')throw new Error('Solo lectura: esta pantalla no puede editar.');let rows;if(op==='list'){rows=read_(sheet_());if(role==='tv'){const at=new Date();const now=Utilities.formatDate(at,'Europe/Madrid','yyyy-MM-dd');const time=Utilities.formatDate(at,'Europe/Madrid','HH:mm');const until=new Date(now+'T12:00:00Z');until.setUTCDate(until.getUTCDate()+14);const last=until.toISOString().slice(0,10);const active=rows.filter(r=>r.ACTIVO&&dateValid_(r.FECHA));const started=new Set(active.filter(r=>r.FECHA<=last).map(r=>r.ID_CURSO||r.ID_SESION));rows=active.filter(r=>started.has(r.ID_CURSO||r.ID_SESION)&&r.FECHA>=now&&(r.FECHA!==now||r.HORA_FIN>time));}}else if(op==='save'){rows=saveSessions_(request.sessions,request.deletedIds||[],request.versions||{});}else{rows=deleteSession_(request.id,request.version);}return {ok:true,rows:rows,role:role};}catch(err){return {ok:false,error:String(err.message||'No se ha podido completar la operación.')};}}
function doPost(e){let result;try{if(!e||!e.postData||e.postData.contents.length>250000)throw new Error('Solicitud no válida.');result=api(JSON.parse(e.postData.contents));}catch(err){result={ok:false,error:'Solicitud no válida.'};}return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);}
function doGet(e){const view=e&&e.parameter&&e.parameter.view;if(view==='setup'){authorized_();return HtmlService.createHtmlOutputFromFile('Setup').setTitle('Cursos V2 | Enlaces de pruebas');}if(view==='admin'||view==='tv'){return HtmlService.createHtmlOutputFromFile(view==='tv'?'Tv':'Admin').setTitle('Cursos V2 | PRUEBAS');}return ContentService.createTextOutput(JSON.stringify({ok:true,service:'Cursos V2 PRUEBAS',data:false})).setMimeType(ContentService.MimeType.JSON);}
function createTestLinks(){authorized_();sheet_();const p=PropertiesService.getScriptProperties(),apiUrl=ScriptApp.getService().getUrl();if(!apiUrl)throw new Error('Primero crea la implementación de pruebas.');const base=p.getProperty('FRONTEND_BASE_URL')||'';if(base&&!/^https:\/\/alvaromartinezisopan\.github\.io\/Cursos-V2\/?$/.test(base))throw new Error('Dirección de pruebas no permitida.');const keys=[0,1].map(()=>Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,''));p.setProperties({TEST_ADMIN_KEY_HASH:digest_(keys[0]),TEST_TV_KEY_HASH:digest_(keys[1])});const make=(role,i)=>(base?base.replace(/\/$/,'')+'/'+(role==='admin'?'Admin.html':'Tv.html'):apiUrl+'?view='+role)+'#backend='+encodeURIComponent(apiUrl)+'&key='+keys[i];return {admin:make('admin',0),tv:make('tv',1)};}
